{
	"name": "obsidian-omi-sync",
	"version": "1.0.0",
	"description": "Sync Omi conversations, memories, and action items to Obsidian",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint src/"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"omi",
		"sync",
		"memory",
		"conversations"
	],
	"author": "Your Name",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"@typescript-eslint/eslint-plugin": "^6.19.0",
		"@typescript-eslint/parser": "^6.19.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.20.0",
		"eslint": "^8.56.0",
		"obsidian": "latest",
		"tslib": "2.6.2",
		"typescript": "5.3.3"
	}
}
